{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flux Image Editing Results API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Key",
      "value": "{{X-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Flux Poll for editing result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bfl.ai/v1/get_result",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "The task ID returned by an editing request."
              }
            ]
          },
          "docs": "Polls the status of an asynchronous image editing task. Returns the current status (Pending, Processing, Ready, Error, or Content Moderated). When status is Ready, the result object contains a pre-signed sample URL to download the edited image."
        }
      ]
    }
  ],
  "bundled": true
}