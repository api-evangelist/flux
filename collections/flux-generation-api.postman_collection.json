          "id": "322642fc-6086-4f8b-b775-9696b73f0fc8",
          "name": "Generate image with FLUX 1.1 [pro]",
          "request": {
            "name": "Generate image with FLUX 1.1 [pro]",
            "description": {
              "content": "Submits an asynchronous image generation request using the FLUX 1.1 [pro] model, which offers improved prompt adherence and image quality over FLUX.1 [pro]. Returns a task ID and polling URL. The caller must poll GET /v1/get_result?id={id} until the status is Ready, then download the image from the returned sample URL.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "flux-pro-1.1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
