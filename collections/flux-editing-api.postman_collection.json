              "mode": "raw",
              "raw": "{\n  \"prompt\": \"<string>\",\n  \"image\": \"<string>\",\n  \"steps\": 28,\n  \"guidance\": 3.5,\n  \"seed\": \"<integer>\",\n  \"safety_tolerance\": 2,\n  \"output_format\": \"jpeg\",\n  \"prompt_upsampling\": false\n}",
