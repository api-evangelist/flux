{
  "info": {
    "_postman_id": "9ed77982-dcdc-43c4-ab1e-b9587c27823b",
    "name": "Flux Image Editing Results API",
    "description": "REST API for editing and transforming existing images using Black Forest Labs' FLUX.1 Kontext models. The Kontext models accept an input image and a text prompt describing desired edits, returning a modified image. They support context-aware in-painting, object replacement, style transfer, background changes, and image-to-image transformations while preserving important visual context. Authentication requires an API key in the X-Key header. Requests are asynchronous and require polling for results.\n\nContact Support:\n Name: Black Forest Labs Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:40:55.000Z",
    "updatedAt": "2026-07-28T01:40:55.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-9ed77982-dcdc-43c4-ab1e-b9587c27823b"
  },
